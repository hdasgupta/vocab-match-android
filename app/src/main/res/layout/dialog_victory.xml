<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp"
    app:strokeColor="@color/success_green"
    app:strokeWidth="2dp"
    app:cardBackgroundColor="@color/card_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎉"
            android:textSize="48sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Word Discovered!"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/success_green"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvDialogSecretWord"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BIRD"
            android:fontFamily="monospace"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:textColor="@color/text_primary"
            android:layout_marginTop="6dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/card_stroke"
            android:layout_marginVertical="16dp" />

        <!-- Score summary -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Guesses taken:"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvDialogGuessesCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Points earned (100 / N):"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvDialogPointsEarned"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25.0 pts"
                android:textStyle="bold"
                android:textColor="@color/primary_brand"
                android:textSize="15sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/card_stroke"
            android:layout_marginVertical="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="New Average Guess:"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvDialogAvgGuesses"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3.20 guesses"
                android:textStyle="bold"
                android:textColor="@color/accent_purple"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Aggregated Points:"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvDialogAggPoints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="150.0 pts"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogPlayAgain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Play Next Word"
            android:textSize="16sp"
            app:cornerRadius="12dp"
            android:backgroundTint="@color/primary_brand"
            android:layout_marginTop="20dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

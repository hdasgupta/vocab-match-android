<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp"
    app:strokeColor="@color/danger_red"
    app:strokeWidth="2dp"
    app:cardBackgroundColor="@color/card_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👁️"
            android:textSize="44sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_revealed_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/danger_red"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvRevealSecretWord"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BIRD"
            android:fontFamily="monospace"
            android:textSize="32sp"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:textColor="@color/text_primary"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/tvRevealMeaning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descriptive meaning here..."
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/card_stroke"
            android:layout_marginVertical="16dp" />

        <!-- Forfeited Points notice -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Points Awarded:"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 pts (Forfeited)"
                android:textStyle="bold"
                android:textColor="@color/danger_red"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No points were added to your aggregated score."
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRevealPlayNext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Play Next Word"
            android:textSize="16sp"
            app:cornerRadius="12dp"
            android:backgroundTint="@color/primary_brand"
            android:layout_marginTop="20dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
